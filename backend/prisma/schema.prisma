generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // DATABASE_URL: pooled connection (Neon's "-pooler" host, via PgBouncer)
  // for normal app queries. DIRECT_URL: the unpooled connection, used only
  // for `prisma migrate` — PgBouncer's transaction pooling mode doesn't
  // support the prepared statements migrations rely on.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String                   @id @default(cuid())
  email          String                   @unique
  passwordHash   String
  createdAt      DateTime                 @default(now())
  wallet         CreditWallet?
  reveals        ContactReveal[]
  searchQueries  SearchQuery[]
  refreshTokens  RefreshToken[]
  aiCredential   UserAiCredential?
  aiDescriptions UserContactDescription[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId])
}

model CreditWallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

enum ReservationStatus {
  PENDING
  SETTLED
  REFUNDED
}

model CreditReservation {
  id        String            @id @default(cuid())
  userId    String
  contactId String
  amount    Int
  status    ReservationStatus @default(PENDING)
  createdAt DateTime          @default(now())
  settledAt DateTime?

  @@index([userId, status])
}

enum ComplianceTier {
  STANDARD
  CAUTION
  RESTRICTED
}

model Company {
  id             String                  @id @default(cuid())
  name           String
  domain         String                  @unique
  industry       String?
  country        String?
  sizeRange      String?
  emailPattern   CompanyEmailPattern?
  contacts       Contact[]
  sourceEvidence CompanySourceEvidence[]
}

model DatasetImport {
  id              String                  @id @default(cuid())
  name            String
  sourceUrl       String
  licenseUrl      String
  licenseName     String
  filePath        String
  format          String
  status          String                  @default("running")
  processed       Int                     @default(0)
  imported        Int                     @default(0)
  rejected        Int                     @default(0)
  error           String?                 @db.Text
  startedAt       DateTime                @default(now())
  completedAt     DateTime?
  companyEvidence CompanySourceEvidence[]
}

model CompanySourceEvidence {
  id              String         @id @default(cuid())
  companyId       String
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  datasetImportId String?
  datasetImport   DatasetImport? @relation(fields: [datasetImportId], references: [id], onDelete: SetNull)
  sourceUrl       String
  licenseUrl      String
  firstSeenAt     DateTime       @default(now())
  lastSeenAt      DateTime       @default(now())

  @@unique([companyId, sourceUrl])
  @@index([datasetImportId])
}

model CompanyEmailPattern {
  id         String   @id @default(cuid())
  companyId  String   @unique
  company    Company  @relation(fields: [companyId], references: [id])
  template   String
  confidence Float
  sampleSize Int      @default(1)
  updatedAt  DateTime @updatedAt
}

model Contact {
  id                String                   @id @default(cuid())
  fullName          String
  firstName         String
  lastName          String
  jobTitle          String?
  seniority         String?
  companyId         String?
  company           Company?                 @relation(fields: [companyId], references: [id])
  country           String?
  industry          String?
  complianceTier    ComplianceTier           @default(STANDARD)
  sourceType        String?
  sourceUrl         String?
  canonicalKey      String?                  @unique
  sourceCount       Int                      @default(0)
  emailAvailability String                   @default("unknown")
  lastSeenAt        DateTime                 @default(now())
  refreshedAt       DateTime                 @default(now())
  createdAt         DateTime                 @default(now())
  reveals           ContactReveal[]
  descriptions      UserContactDescription[]
  searchResults     SearchResult[]
  sourceEvidence    ContactSourceEvidence[]

  @@unique([sourceType, sourceUrl, fullName])
  @@index([industry, country])
}

model ContactSourceEvidence {
  id          String   @id @default(cuid())
  contactId   String
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sourceType  String
  sourceUrl   String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([contactId, sourceUrl])
  @@index([sourceType, lastSeenAt])
}

model ContactReveal {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  contactId          String
  contact            Contact  @relation(fields: [contactId], references: [id])
  email              String
  confidence         Float
  verificationStatus String
  revealedAt         DateTime @default(now())

  @@unique([userId, contactId])
}

model UserAiCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id])
  provider     String   @default("openai")
  encryptedKey String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model UserContactDescription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id])
  text      String   @db.Text
  source    String
  createdAt DateTime @default(now())

  @@unique([userId, contactId])
}

model SuppressionEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String
  createdAt DateTime @default(now())
}

model SearchQuery {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  filters     Json
  status      String
  resultCount Int            @default(0)
  createdAt   DateTime       @default(now())
  results     SearchResult[]
}

model SearchResult {
  searchQueryId String
  contactId     String
  searchQuery   SearchQuery @relation(fields: [searchQueryId], references: [id], onDelete: Cascade)
  contact       Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([searchQueryId, contactId])
  @@index([contactId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
}

model DirectoryCrawlProgress {
  id           String   @id @default(cuid())
  directoryId  String
  industrySlug String
  locationSlug String
  lastPage     Int      @default(0)
  status       String   @default("in_progress")
  updatedAt    DateTime @updatedAt

  @@unique([directoryId, industrySlug, locationSlug])
}
